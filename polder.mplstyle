# POLDER practical style — Complex Systems 2026-27
# Load with: plt.style.use(<path>/2026-27/templates/polder.mplstyle)

# figure
figure.facecolor: white
figure.dpi: 110
savefig.dpi: 150
savefig.bbox: tight

# fonts
font.family: sans-serif
font.size: 11

# axes
axes.facecolor: white
axes.edgecolor: 333333
axes.linewidth: 0.8
axes.titlesize: 13
axes.titleweight: bold
axes.titlecolor: 006661
axes.labelsize: 11
axes.labelcolor: 222222
axes.spines.top: False
axes.spines.right: False
axes.prop_cycle: cycler('color', ['0A4D9E', '00A39B', 'E8633A', '006661', 'E6A700', '6A4C93', 'C8417B', '5F6B7A'])

# grid
axes.grid: True
grid.color: DDDDDD
grid.linewidth: 0.6

# lines
lines.linewidth: 2.0
lines.markersize: 6

# ticks
xtick.color: 444444
ytick.color: 444444
xtick.labelsize: 10
ytick.labelsize: 10

# legend
legend.frameon: False

# images
image.cmap: viridis
